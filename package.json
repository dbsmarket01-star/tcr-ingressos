{
  "name": "ingressaas-bilheteria",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "repo:check-hygiene": "tsx scripts/check-repo-hygiene.ts",
    "security:audit": "npm audit --omit=dev",
    "release:check": "npm run repo:check-hygiene && npm run db:check-migrations && npm run db:validate && npm test && npm run typecheck && npm run build",
    "dns:apple-local": "tsx scripts/apple_local_dns_server.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:check-migrations": "tsx scripts/check-prisma-migration-history.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "next": "16.2.3",
    "pg": "8.20.0",
    "prisma": "6.19.3",
    "qrcode": "1.5.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "resend": "6.12.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "25.6.0",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "vitest": "3.2.4"
  }
}
