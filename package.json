{
  "name": "ingressaas-bilheteria",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "npm run test:payment-safety && prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "test:payment-safety": "node ./node_modules/vitest/vitest.mjs run tests/payments/payment-fee-calculator.test.ts tests/payments/asaas-split-calculation.test.ts tests/payments/asaas-pix-provider.test.ts tests/payments/payment-organization-config.test.ts tests/payments/payment-pricing-guards.test.ts tests/pricing/public-price-rounding.test.ts",
    "test:watch": "vitest",
    "dns:apple-local": "tsx scripts/apple_local_dns_server.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "dotenv": "17.4.2",
    "next": "16.2.3",
    "pg": "8.20.0",
    "prisma": "6.19.3",
    "qrcode": "1.5.4",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "resend": "6.12.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "25.6.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "tsx": "4.21.0",
    "typescript": "6.0.2",
    "vitest": "3.2.4"
  }
}
